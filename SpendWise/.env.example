# ==============================================================================
# SPENDWISE — ENVIRONMENT VARIABLES (.env.example)
# Copy this file to `.env` and fill in your keys. NEVER commit `.env` to GitHub.
# ==============================================================================

# LLM API Key (Used by agent/graph.py & tools/ocr_tool.py Vision fallback)
GEMINI_API_KEY="your_gemini_api_key_here"
# Gemini model used by the agent. Older models get retired — if you see a 404
# "model not found" error, change this to a newer model name.
GEMINI_MODEL="gemini-3.8-flash"
OPENAI_API_KEY="your_optional_openai_key_here"

# SQLite Database Path (Defaults to data/spendwise.db)
SPENDWISE_DB_PATH="data/spendwise.db"

# Demo data in a NEW database: true = demo data (dated relative to today), false = start empty
SPENDWISE_SEED_DEMO="true"

# ChromaDB Persistent Directory (Defaults to data/chroma_memory)
CHROMA_PERSIST_DIR="data/chroma_memory"

# Tesseract OCR Binary Path (Optional — only needed on Windows if not in PATH)
# TESSERACT_CMD_PATH="C:\\Program Files\\Tesseract-OCR\\tesseract.exe"
